# Server defaults to localhost-only (127.0.0.1) for security.
# Set BIND=0.0.0.0 to expose on the network — and use TLS when doing so.
#
# For TLS, generate a self-signed cert:
#   openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem \
#     -days 365 -nodes -subj '/CN=omarchy-vm'
# Then set TLS_CERT and TLS_KEY to the absolute paths.

OMARCHY_MCP_TOKEN=changeme-use-openssl-rand-hex-32
PORT=8911
BIND=127.0.0.1
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem